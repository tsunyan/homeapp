<UserControl
    x:Class="HomeApp.Controls.WidgetFrame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Card" CornerRadius="8" BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8" Padding="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="MoveHandle" Background="Transparent"
                      PointerPressed="Move_Pressed" PointerMoved="Handle_Moved"
                      PointerReleased="Handle_Released" PointerCaptureLost="Handle_CaptureLost">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="WidgetIcon" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock x:Name="TitleText" Grid.Column="1" Margin="10,0,4,0"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                    <FontIcon x:Name="DragIndicator" Grid.Column="2" Glyph="&#xE700;" FontSize="12"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
                <Button Grid.Column="1" x:Name="MoreButton" Style="{StaticResource SubtleButtonStyle}"
                        Width="30" Height="30" Padding="0" ToolTipService.ToolTip="ウィジェットの操作"
                        AutomationProperties.Name="ウィジェットの操作">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="位置・サイズ・設定" Click="Settings_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="複製" Click="Duplicate_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="削除" Click="Delete_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <ContentControl x:Name="Body" Grid.Row="1" Padding="16,0,16,0"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <Grid Grid.Row="2" Padding="16,0,16,0">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="4" Height="4" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="StatusText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid x:Name="ResizeHandle" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,-14,0" Background="Transparent" Visibility="Collapsed"
                      PointerPressed="Resize_Pressed" PointerMoved="Handle_Moved"
                      PointerReleased="Handle_Released" PointerCaptureLost="Handle_CaptureLost"
                      AutomationProperties.Name="サイズを変更">
                    <FontIcon Glyph="&#xE784;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,4" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
