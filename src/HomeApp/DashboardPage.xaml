<Page
    x:Class="HomeApp.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <NavigationView x:Name="Navigation" PaneDisplayMode="Auto" OpenPaneLength="212" CompactPaneLength="48"
                    IsBackButtonVisible="Collapsed" IsSettingsVisible="True" AlwaysShowHeader="False"
                    SelectionChanged="Navigation_SelectionChanged" PaneTitle="ホーム">
        <NavigationView.MenuItems>
            <NavigationViewItemHeader Content="マイボード" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="ボードを追加" Tag="add-board">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Add" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="使い方" Tag="help">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE897;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>
        <Grid x:Name="Surface" Margin="0,0,8,8" CornerRadius="8" BorderThickness="1"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>
            <Grid x:Name="Header" Padding="24,20,16,16" ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="BoardTitle" Text="マイホーム" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DayCaption" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <CommandBar x:Name="Toolbar" Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="True" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="680">
                    <AppBarButton Icon="Add" Label="追加" Click="AddWidget_Click" ToolTipService.ToolTip="ウィジェットを追加" />
                    <AppBarToggleButton x:Name="EditButton" Icon="Edit" Label="配置を編集" Checked="Edit_Checked" Unchecked="Edit_Unchecked" />
                    <AppBarButton x:Name="UndoButton" Icon="Undo" Label="元に戻す" Click="Undo_Click" Visibility="Collapsed" />
                    <AppBarButton x:Name="SaveButton" Icon="Save" Label="保存" Click="Save_Click" Visibility="Collapsed" />
                    <AppBarButton x:Name="CancelButton" Icon="Cancel" Label="キャンセル" Click="Cancel_Click" Visibility="Collapsed" />
                    <CommandBar.SecondaryCommands>
                        <AppBarButton Label="幅に合わせて整列" Icon="AlignLeft" Click="Arrange_Click" />
                        <AppBarButton Label="ボード名を変更" Icon="Rename" Click="RenameBoard_Click" />
                        <AppBarButton Label="表示設定" Icon="Setting" Click="Settings_Click" />
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </Grid>
            <InfoBar x:Name="MessageBar" Grid.Row="1" Margin="16,0,16,8" IsOpen="False" />
            <Grid x:Name="EditBar" Grid.Row="2" Margin="24,0,24,12" ColumnSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="見出しをドラッグして移動。右下をつかんでサイズ変更。" FontSize="12"
                           VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ToggleSwitch x:Name="SnapToggle" Grid.Column="1" OnContent="スナップ ON" OffContent="スナップ OFF"
                              MinWidth="0" Toggled="Snap_Toggled" AutomationProperties.Name="グリッドにスナップ" />
            </Grid>
            <SplitView x:Name="InspectorSplit" Grid.Row="3" PanePlacement="Right" OpenPaneLength="280"
                       CompactPaneLength="0" DisplayMode="Inline" IsPaneOpen="False">
                <SplitView.Pane>
                    <Border BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="16">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <TextBlock Text="ウィジェットの設定" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" Padding="6"
                                            Click="CloseInspector_Click" AutomationProperties.Name="設定パネルを閉じる"><FontIcon Glyph="&#xE711;" FontSize="12" /></Button>
                                </Grid>
                                <TextBox x:Name="TitleBox" Header="タイトル" MaxLength="80" LostFocus="Title_LostFocus" />
                                <TextBlock Text="位置" FontWeight="SemiBold" FontSize="12" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="XBox" Header="左" Minimum="0" Maximum="100000" SmallChange="8" SpinButtonPlacementMode="Compact" ValueChanged="Geometry_ValueChanged" />
                                    <NumberBox x:Name="YBox" Grid.Column="1" Header="上" Minimum="0" Maximum="100000" SmallChange="8" SpinButtonPlacementMode="Compact" ValueChanged="Geometry_ValueChanged" />
                                </Grid>
                                <TextBlock Text="サイズ" FontWeight="SemiBold" FontSize="12" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="WidthBox" Header="幅" Minimum="240" Maximum="8192" SmallChange="16" SpinButtonPlacementMode="Compact" ValueChanged="Geometry_ValueChanged" />
                                    <NumberBox x:Name="HeightBox" Grid.Column="1" Header="高さ" Minimum="180" Maximum="8192" SmallChange="16" SpinButtonPlacementMode="Compact" ValueChanged="Geometry_ValueChanged" />
                                </Grid>
                                <StackPanel x:Name="ClockSettings" Spacing="12" Visibility="Collapsed">
                                    <ToggleSwitch x:Name="SecondsToggle" Header="秒を表示" Toggled="Clock_Toggled" />
                                    <ToggleSwitch x:Name="HourToggle" Header="24時間表示" Toggled="Clock_Toggled" />
                                </StackPanel>
                                <TextBlock Text="数値でも調整できます。ズームやウィンドウの大きさを変えても、配置は保持されます。"
                                           FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Content="複製" Click="DuplicateSelected_Click" HorizontalAlignment="Stretch" />
                                <Button Content="このウィジェットを削除" Click="DeleteSelected_Click" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </SplitView.Pane>
                <Grid>
                    <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                                  ZoomMode="Enabled" MinZoomFactor="0.35" MaxZoomFactor="2"
                                  ViewChanged="Viewport_ViewChanged" SizeChanged="Viewport_SizeChanged"
                                  HorizontalContentAlignment="Left" VerticalContentAlignment="Top">
                        <Canvas x:Name="BoardCanvas" Background="Transparent" Width="1200" Height="900">
                            <Canvas x:Name="GridLines" IsHitTestVisible="False" />
                        </Canvas>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                        <FontIcon Glyph="&#xE80A;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="ここから、自分のホームを。" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="時計やメモなど、必要なものを追加してください。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="ウィジェットを追加" Style="{StaticResource AccentButtonStyle}" Click="AddWidget_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </SplitView>
            <Grid Grid.Row="4" Padding="20,0,16,0" ColumnSpacing="12" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel x:Name="FooterStatus" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Name="WidgetCount" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="SaveStatus" Text="このPCに保存済み" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="全体を表示" Padding="10,4" Click="Fit_Click" ToolTipService.ToolTip="ウィジェット全体が見える倍率に調整" />
                    <Slider x:Name="ZoomSlider" Width="132" Minimum="35" Maximum="200" Value="100" StepFrequency="5"
                            ValueChanged="Zoom_ValueChanged" AutomationProperties.Name="表示倍率" VerticalAlignment="Center" />
                    <Button x:Name="ZoomReset" Content="100%" Width="62" Padding="4" Click="ZoomReset_Click" ToolTipService.ToolTip="100%に戻す" />
                </StackPanel>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
